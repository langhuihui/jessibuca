{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "typeRoots": [
      "./node_modules/@types",
      "../../types"
    ]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"],
  "extends": "../../tsconfig.json"
}